# ============================================
# CreatorForge .gitignore
# ============================================

# === Secrets & Credentials ===
.env
.env.*
!.env.example
credentials.key
scripts/client_secret.json
*.token
*.pem

# === User Data (per-channel, never commit) ===
channels/*/brain.json
channels/*/data/
channels/*/active_production/
!channels/*/channel_config.json

# === Legacy data/ directory ===
data/agent-brain.json
data/topics/
data/angles.jsonl
data/hooks.jsonl
data/scripts.jsonl
data/analytics/
data/insights/
data/idea-board.jsonl
data/calendar.jsonl
data/recon/
data/hooks/
data/scripts/
data/angles/
!data/cta-templates.json

# === Recon runtime data ===
agent_core/recon/data/
agent_core/recon/cache/*.txt
agent_core/recon/*.db

# === Production output ===
production/RenderEngine/render/
*/active_production/render/
*/active_production/assets/
*/active_production/audio/

# === SQLite databases ===
*.db
*.sqlite
*.sqlite3

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/
*.egg

# === Node ===
node_modules/
.opencode/node_modules/

# === Logs ===
logs/
*.log

# === IDE & Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === OS ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# === Planning (internal GSD workflow) ===
.planning/

# === PAUL workflow (dev only) ===
.paul/

# === Reports (generated) ===
*-report.md

# === Temporary files ===
/tmp/
tmp/
*.tmp
*.bak
