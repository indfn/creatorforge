# ──────────────────────────────────────────────────────────────
# GoviralBro — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────
#
# Provider configuration follows this pattern:
#   {PROVIDER}_API_KEY       — API key (omit if auth not needed)
#   {PROVIDER}_BASE_URL      — Custom endpoint (omit to use default)
#   {PROVIDER}_ENABLED       — Set "false" to disable (default: "true")
#
# {PROVIDER}_FORMAT is available for providers that support
# both OpenAI-compatible and original formats.
#
# ──────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════
# RECON MODULE — Content Skeleton Ripper (LLM + Transcription)
# ══════════════════════════════════════════════════════════════

# -- LLM Provider (chat/completions for extraction & synthesis) --
# Uses OpenAI-compatible /chat/completions format.
# Default: https://api.openai.com/v1
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# -- Transcription Provider (audio/transcriptions) --
# Uses OpenAI-compatible /audio/transcriptions format.
# Default: https://api.openai.com/v1
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1

# -- Local Whisper (alternative to API-based transcription) --
# Set TRANSCRIBE_PROVIDER=local to use local whisper instead
# TRANSCRIBE_PROVIDER=openai
# WHISPER_MODEL=small.en

# -- Ollama (local LLM, no API key needed) --
# Uses its own chat format (not OpenAI-compatible).
# Default: http://localhost:11434
# OLLAMA_BASE_URL=

# -- LLM Provider name override --
# Set to "local" to use Ollama for LLM calls.
# OpenRouter or any OpenAI-compatible endpoint: use "custom" (default) with LLM_BASE_URL.
# LLM_ENABLED=true


# ══════════════════════════════════════════════════════════════
# SKILL: last30days — Reddit Discovery (via OpenAI Responses API)
# ══════════════════════════════════════════════════════════════
# Uses OpenAI Responses API with web_search tool,
# scoped to reddit.com. Requires an OpenAI API key.
# Default endpoint: https://api.openai.com/v1/responses
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_REDDIT_ENABLED=true
# OPENAI_REDDIT_BASE_URL=
# OPENAI_REDDIT_MODEL=gpt-4.1
# OPENAI_MODEL_POLICY=auto
# OPENAI_MODEL_PIN=


# ══════════════════════════════════════════════════════════════
# SKILL: last30days — X/Twitter Search via xAI API
# ══════════════════════════════════════════════════════════════
# Uses xAI Responses API with x_search tool (grok models).
# Default endpoint: https://api.x.ai/v1/responses
# XAI_API_KEY=
# XAI_X_ENABLED=true
# XAI_X_BASE_URL=
# XAI_MODEL_POLICY=latest
# XAI_MODEL_PIN=


# ══════════════════════════════════════════════════════════════
# SKILL: last30days — Web Search Providers
# ══════════════════════════════════════════════════════════════
# Three backends available (used in priority order).
# At least one must be enabled for web search to work.

# --- OpenRouter / Perplexity Sonar Pro ---
# Default endpoint: https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_API_KEY=
# OPENROUTER_SEARCH_ENABLED=true
# OPENROUTER_BASE_URL=
# OPENROUTER_MODEL=perplexity/sonar-pro

# --- Parallel AI Search ---
# Default endpoint: https://api.parallel.ai/v1beta/search
# PARALLEL_API_KEY=
# PARALLEL_SEARCH_ENABLED=true
# PARALLEL_BASE_URL=

# --- Brave Search ---
# Default endpoint: https://api.search.brave.com/res/v1/web/search
# BRAVE_API_KEY=
# BRAVE_SEARCH_ENABLED=true
# BRAVE_BASE_URL=


# ══════════════════════════════════════════════════════════════
# SKILL: last30days — YouTube Search (yt-dlp, no API key needed)
# ══════════════════════════════════════════════════════════════
# Uses yt-dlp CLI. No configuration needed beyond having yt-dlp
# installed and in PATH.
# YOUTUBE_ENABLED=true


# ══════════════════════════════════════════════════════════════
# INSTAGRAM (run scripts/setup-ig-token.py to populate)
# ══════════════════════════════════════════════════════════════
# Instagram Graph API — per-Reel insights, follower growth
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=


# ══════════════════════════════════════════════════════════════
# YOUTUBE ANALYTICS (OAuth-based)
# ══════════════════════════════════════════════════════════════
# YouTube Data API v3 — video metadata, stats
# YouTube Analytics API — CTR, watch time, subscribers gained
# Run scripts/setup-yt-oauth.py after setting this key.
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here
# YOUTUBE_DATA_BASE_URL=
# YOUTUBE_ANALYTICS_BASE_URL=

# ── Legacy (used by recon/config.py for backward compatibility) ──
# IG_USERNAME=your_ig_username
# IG_PASSWORD=your_ig_password


# ══════════════════════════════════════════════════════════════
# LEGACY — kept for backward compatibility
# ══════════════════════════════════════════════════════════════
# These are no longer needed individually; they map to the
# unified LLM/transcribe provider system above.
# ANTHROPIC_API_KEY=   →  use LLM_BASE_URL with an OpenAI-compatible endpoint
# GOOGLE_API_KEY=      →  use LLM_BASE_URL with an OpenAI-compatible endpoint