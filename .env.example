# ──────────────────────────────────────────────────────────────
# CreatorForge — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# 💰 marks paid APIs (usage costs apply).
# 🆓 marks free options available with no API key or generous free tier.


# ══════════════════════════════════════════════════════════════
# RECON MODULE — Competitor content analysis
# ══════════════════════════════════════════════════════════════

# -- Credential Encryption --
# 🆓 Local, no API needed.
CREDENTIALS_ENCRYPTION_KEY=

# -- LLM Provider (extracts content skeletons from competitor transcripts) --
# 💰 Paid by default (OpenAI API). Alternative: Ollama (free, local, use provider='local' in code).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434

# -- Transcription (transcribes downloaded competitor videos) --
# 🆓 Groq is free-tier default (rate-limited, whisper-large-v3-turbo).
# 💰 Alternative: OpenAI Whisper (set TRANSCRIBE_BASE_URL to https://api.openai.com/v1).
# 🆓 Local alternative: set TRANSCRIBE_PROVIDER=local for free local Whisper.
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=  # 🆓 Free tier, rate-limited. Used as TRANSCRIBE_API_KEY when set.
# OPENAI_API_KEY note: still needed for LLM skeleton extraction (not transcription by default)
RECON_TARGET_LANGUAGE=en  # Language for YouTube captions: en, es, fr, etc.


# ══════════════════════════════════════════════════════════════
# YOUTUBE ANALYTICS (OAuth + API key)
# ══════════════════════════════════════════════════════════════
# 🆓 Free tier (10,000 quota units/day).
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here
YOUTUBE_DATA_BASE_URL=
YOUTUBE_ANALYTICS_BASE_URL=


# ══════════════════════════════════════════════════════════════
# INSTAGRAM (Graph API — run scripts/setup-ig-token.py to populate)
# ══════════════════════════════════════════════════════════════
# 🆓 Free (requires Facebook app review for some endpoints).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=


# ══════════════════════════════════════════════════════════════
# AUDIO PRODUCTION — TTS + Force Alignment (Phase 9)
# ══════════════════════════════════════════════════════════════

# -- Custom TTS (primary — Gemini Flash TTS proxy) --
# 💰 Cost depends on the proxy backend. Free if using a local proxy.
TTS_PROXY_URL=http://127.0.0.1:8317/v1beta/models/gemini-3.1-flash-tts-preview:generateContent
TTS_API_KEY=

# -- Gemini TTS (first fallback if custom fails) --
# 🆓 Free tier (60 req/min via Google AI Studio).
GEMINI_API_KEY=

# -- Force Alignment (Groq Whisper API, primary) --
# 🆓 Free tier (rate-limited). Falls back to local faster-whisper if unset.
GROQ_API_KEY=


# ══════════════════════════════════════════════════════════════
# VISUAL ASSET PIPELINE — Stock API Providers (Phase 10)
# ══════════════════════════════════════════════════════════════

# -- Pexels API (primary B-roll footage/images) --
# 🆓 Free (200 req/hr, 20K/month).
PEXELS_API_KEY=

# -- Pixabay API (fallback B-roll/images) --
# 🆓 Free (unlimited monthly).
PIXABAY_API_KEY=

# -- Freesound API (SFX sound effects) --
# 🆓 Free (60 req/min, 2K/day). Preview URLs only, non-commercial use.
FREESOUND_API_KEY=

# -- Wikimedia Commons (free, no API key) --
# 🆓 Free, unlimited.
WIKIMEDIA_COMMONS_ENABLED=true
WIKIMEDIA_COMMONS_BRITISH_LIBRARY_BOOST=true


# ══════════════════════════════════════════════════════════════
# SKILL: last30days — Content idea research (Reddit / X / Web / YouTube)
# ══════════════════════════════════════════════════════════════
# Used by the last30days agent skill to find trending topics.
# Not required for core pipeline operation.
# Web search automatically uses any built-in WebSearch tool first, so websearch providers (used by .agents/skills/last30days/scripts) are commented out by default.
# Only Reddit (OpenAI) and X (xAI) need API keys here.

# -- OpenAI (Reddit discovery via Responses API + web_search) --
# 💰 Paid (OpenAI API usage).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REDDIT_ENABLED=true
OPENAI_REDDIT_BASE_URL=
OPENAI_REDDIT_MODEL=gpt-4.1
OPENAI_MODEL_POLICY=auto
OPENAI_MODEL_PIN=

# -- xAI / Grok (X/Twitter search) --
# 💰 Paid (xAI API ~$1.25/M input tokens).
XAI_API_KEY=
XAI_X_ENABLED=true
XAI_X_BASE_URL=
XAI_MODEL_POLICY=latest
XAI_MODEL_PIN=

# -- OpenRouter / Perplexity Sonar Pro (web search) --
# 💰 Paid (per-token costs).
# OPENROUTER_API_KEY=
# OPENROUTER_SEARCH_ENABLED=true
# OPENROUTER_BASE_URL=
# OPENROUTER_MODEL=perplexity/sonar-pro

# -- Parallel AI (web search) --
# 💰 Paid.
# PARALLEL_API_KEY=
# PARALLEL_SEARCH_ENABLED=true
# PARALLEL_BASE_URL=

# -- Brave Search (web search) --
# 🆓 Free tier (2,000 queries/month).
# BRAVE_API_KEY=
# BRAVE_SEARCH_ENABLED=true
# BRAVE_BASE_URL=

# -- YouTube (yt-dlp, no API key needed) --
# 🆓 Free.
YOUTUBE_ENABLED=true
